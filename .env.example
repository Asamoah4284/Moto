# Copy to .env at the project root and fill in real values.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=motobike"
PORT=4000
JWT_SECRET="change-me"

# Frontend (Vercel Environment Variables — set in the Vercel project, not here)
# Public backend origin only, no /api and no trailing slash. Local Vite uses /api proxy.
# VITE_API_URL=https://your-api.onrender.com
